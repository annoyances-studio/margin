# Normalize line endings: text files are stored with LF in the repo and
# checked out with the platform's native endings. Keeps diffs clean across
# Windows, macOS and Linux contributors.
* text=auto eol=lf

# Source and config: always LF
*.dart   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.gradle text eol=lf
*.kts    text eol=lf
*.cmake  text eol=lf
*.sh     text eol=lf

# Windows-specific files must keep CRLF
*.bat       text eol=crlf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.sln       text eol=crlf
*.vcxproj   text eol=crlf
*.manifest  text eol=crlf

# Binary assets: never touch
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.icns     binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.keystore binary
*.jks      binary
